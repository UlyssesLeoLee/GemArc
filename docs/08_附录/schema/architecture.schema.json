{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gemarc/schema/architecture/1.0.0",
  "title": "GemArc Architecture Model (proposed minimum contract)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "meta",
    "nodes",
    "edges",
    "viewpoints",
    "views",
    "evidence"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "language"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "zh-CN",
            "ja-JP",
            "en-US"
          ]
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceRef"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "object"
          }
        }
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "viewpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stakeholders",
          "concerns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stakeholders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "concerns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "viewpointId",
          "entityIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "viewpointId": {
            "type": "string"
          },
          "entityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "causalModels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lock": {
      "type": "object"
    }
  },
  "$defs": {
    "verification": {
      "enum": [
        "confirmed",
        "assumed",
        "illustrative",
        "unknown"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
