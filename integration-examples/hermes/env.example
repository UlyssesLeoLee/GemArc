# Append to ~/.hermes/.env (Windows native: %LOCALAPPDATA%\hermes\.env). Never commit the real file.
# The client-side variable: put YOUR access token here.
#   - accounts deployment: the personal access token you created on the account page
#     (https://<project>.vercel.app/account ; the plaintext is shown only once).
#   - deployment without accounts: the shared token the operator gave you.
# The server-side variable has another name: GEMARC_MCP_TOKEN (the shared token of a deployment
# that does not use accounts). Do not mix the two.
GEMARC_MCP_PAT=<token>
