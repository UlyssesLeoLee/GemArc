# Vite is a BUILD-TIME dependency, and this viewer is built and shipped from source.
# If the machine or CI sets NODE_ENV=production (or npm_config_omit=dev), a plain
# `npm install` silently skips devDependencies: `vite` never installs, and `npm run
# build` then fails with a confusing "Rolldown failed to resolve import 'three'".
# That error points at the wrong package -- the real cause is a missing build tool.
# Forcing devDependencies on makes the documented commands work everywhere.
include=dev
