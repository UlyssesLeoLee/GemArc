{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemarc.dev/schemas/0.3.0/execution-graph.schema.json",
  "title": "6D Execution Graph IR",
  "description": "v6.0 提示词 §25 的 6D 执行图 IR 契约，以及 §17 GWF-IR 6D 扩展里的执行节点/边/运行字段。这是**模型层契约**：它规定执行图必须声明什么，不提供执行能力。真实执行必须另有获授权的后端（orchestration_6d.real_execution_requires_authorized_backend）；在只有静态交付物时必须标明生产执行不支持。",
  "type": "object",
  "required": ["executionGraphId", "version", "nodes"],
  "additionalProperties": true,
  "properties": {
    "executionGraphId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$",
      "description": "执行图稳定 ID。"
    },
    "workflowId": {
      "type": ["string", "null"],
      "default": null,
      "description": "来源工作流 ID。执行图必须能回溯到它。"
    },
    "version": {
      "type": ["string", "null"],
      "default": null,
      "description": "执行图版本。§17 要求版本化：恢复时必须拒绝不兼容的版本。"
    },
    "stateSchemaVersion": {
      "type": ["string", "null"],
      "default": null,
      "description": "共享状态的 schema 版本。§25：状态提交在明确的持久化边界发生；状态提交必须可校验。"
    },
    "executionMode": {
      "type": "string",
      "enum": ["simulation", "dry-run", "real"],
      "default": "simulation",
      "description": "运行模式。默认 simulation（无真实副作用）。real 必须存在获授权的执行后端。"
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "本执行图需要的能力。与执行器能力匹配后才能真实运行。"
    },
    "nodes": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/executionNode"}
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/executionEdge"}
    },
    "workPackages": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/workPackage"},
      "description": "WBS 分解层（6D = WBS × 执行图）。工作包说明做什么、产出什么、何时算完成；nodeIds 把工作包绑定到本图的执行节点。"
    },
    "runs": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/run"},
      "description": "运行记录。审计轨迹必须可回溯到 runId 与 traceId。"
    },
    "checkpoints": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/checkpoint"},
      "description": "检查点目录。跨重启的持久化由明确的检查点与存储层负责；边上带状态不等于可恢复。"
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "证据 ID 列表，指向顶层 evidence 数组。"
    },
    "verification": {
      "type": ["string", "null"],
      "default": null,
      "enum": ["Implemented", "Observed", "Designed", "Inferred", "Hypothetical", "Unknown", null],
      "description": "事实等级，取值见 vocab/evidence-levels.json"
    },
    "stateFieldRef": {
      "type": "string",
      "minLength": 1,
      "description": "共享状态里的一个字段路径。"
    },
    "executionNode": {
      "type": "object",
      "required": ["nodeId", "kind"],
      "additionalProperties": true,
      "properties": {
        "nodeId": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$"},
        "kind": {
          "type": "string",
          "enum": ["agent-loop", "deterministic-program", "human-approval", "tool-call",
                   "policy-gate", "checkpoint", "join-fork", "retry-timeout", "compensation", "end"],
          "description": "§25 node_kinds。"
        },
        "name": {"type": ["string", "null"], "default": null},
        "executorRef": {
          "type": ["string", "null"],
          "default": null,
          "description": "执行器引用。缺失表示没有真实执行器：节点必须标 Design-only。"
        },
        "inputSchema": {
          "type": ["object", "null"],
          "default": null,
          "description": "输入契约。必须可被程序读取。"
        },
        "outputSchema": {
          "type": ["object", "null"],
          "default": null,
          "description": "输出契约。必须可被程序读取。"
        },
        "stateReadSet": {
          "type": "array",
          "default": [],
          "items": {"$ref": "#/$defs/stateFieldRef"},
          "description": "该节点获准读取的状态字段。"
        },
        "stateWriteSet": {
          "type": "array",
          "default": [],
          "items": {"$ref": "#/$defs/stateFieldRef"},
          "description": "该节点获准写入的状态字段。节点只能修改自己获准的字段。"
        },
        "timeout": {
          "type": ["object", "null"],
          "default": null,
          "description": "超时策略：时长与超时后的处理。"
        },
        "retry": {
          "type": ["object", "null"],
          "default": null,
          "description": "重试策略：次数与退避。"
        },
        "idempotencyKeyStrategy": {
          "type": ["string", "null"],
          "default": null,
          "description": "幂等键策略。有副作用的节点缺失时必须被拒绝（unsafe_side_effect_replay）。"
        },
        "authorityPolicyRef": {
          "type": ["string", "null"],
          "default": null,
          "description": "权限策略引用。工具调用与审批节点缺失时必须被拒绝。"
        },
        "iterationLimit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null,
          "description": "Agent 循环的最大迭代次数。缺失即判为无界循环（unbounded_agent_loop）。"
        },
        "budgetPolicy": {
          "type": ["object", "null"],
          "default": null,
          "description": "预算策略：token / 时间 / 调用次数上限。"
        },
        "approvalPolicyRef": {
          "type": ["string", "null"],
          "default": null,
          "description": "审批策略引用。人工审批节点缺失时必须被拒绝（human_approval_bypass）。"
        },
        "toolContractRef": {
          "type": ["string", "null"],
          "default": null,
          "description": "工具契约引用。工具调用节点缺失时不得发起真实调用。"
        },
        "evidenceIds": {"$ref": "#/$defs/evidenceRefs"},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },
    "executionEdge": {
      "type": "object",
      "required": ["edgeId", "sourceNodeId", "targetNodeId", "kind"],
      "additionalProperties": true,
      "properties": {
        "edgeId": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$"},
        "sourceNodeId": {"type": "string"},
        "sourcePortId": {"type": ["string", "null"], "default": null},
        "targetNodeId": {"type": "string"},
        "targetPortId": {"type": ["string", "null"], "default": null},
        "kind": {
          "type": "string",
          "enum": ["control-flow", "data-flow", "event-flow", "error-flow", "conditional-flow",
                   "compensation-flow", "dependency", "state-transition", "approval-transition",
                   "tool-result", "retry-transition", "timeout-transition", "resume-transition"],
          "description": "取值见 vocab/workflow-kinds.json edgeKinds。"
        },
        "guardExpression": {
          "type": ["string", "null"],
          "default": null,
          "description": "路由条件。条件边缺失时必须被拒绝（missing_route_guard）。"
        },
        "dataMapping": {"type": ["object", "null"], "default": null},
        "stateSchemaRef": {
          "type": ["string", "null"],
          "default": null,
          "description": "该边传递的状态 schema 引用。缺失时该边不得携带状态。"
        },
        "stateProjection": {"type": ["object", "null"], "default": null},
        "stateMergePolicy": {
          "type": ["string", "null"],
          "default": null,
          "description": "并行分支的状态归并策略。缺失时无法检测归并冲突。"
        },
        "priority": {"type": ["number", "null"], "default": null},
        "onError": {"type": ["string", "null"], "default": null},
        "onTimeout": {"type": ["string", "null"], "default": null},
        "deliverySemantics": {
          "type": ["string", "null"],
          "default": null,
          "enum": ["at-most-once", "at-least-once", "exactly-once", null]
        },
        "checkpointBoundary": {
          "type": ["boolean", "null"],
          "default": null,
          "description": "该边是否是检查点边界。边界存在但状态 schema 未声明时必须被拒绝。"
        },
        "policyRef": {"type": ["string", "null"], "default": null},
        "evidenceIds": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "workPackage": {
      "type": "object",
      "required": ["packageId", "kind"],
      "additionalProperties": true,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$",
          "description": "工作包稳定 ID。"
        },
        "parentPackageId": {
          "type": ["string", "null"],
          "default": null,
          "description": "父工作包 ID。顶层阶段为 null。有且只有一个根，且不得成环。"
        },
        "kind": {
          "type": "string",
          "enum": ["phase", "work-package", "task"],
          "description": "WBS 层级：阶段 / 工作包 / 任务。"
        },
        "title": {"type": ["string", "null"], "default": null},
        "deliverable": {
          "type": ["string", "null"],
          "default": null,
          "description": "交付物。这一层产出什么。缺失即不构成 WBS（wbs_missing_deliverable）。"
        },
        "completionCriteria": {
          "type": ["string", "null"],
          "default": null,
          "description": "完成条件。何时算做完。缺失即不构成 WBS（wbs_missing_deliverable）。"
        },
        "nodeIds": {
          "type": "array",
          "default": [],
          "items": {"type": "string"},
          "description": "归属的执行节点 ID（指向本图 nodes[].nodeId）。空包即不构成 WBS（wbs_unbound_package）。"
        },
        "dependsOn": {
          "type": "array",
          "default": [],
          "items": {"type": "string"},
          "description": "跨包依赖的工作包 ID。依赖与执行边是两件事，不得互相替代。"
        },
        "evidenceIds": {"$ref": "#/$defs/evidenceRefs"},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },
    "run": {
      "type": "object",
      "required": ["runId", "workflowId", "workflowVersion", "mode", "status"],
      "additionalProperties": true,
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "workflowId": {"type": "string", "minLength": 1},
        "workflowVersion": {
          "type": "string",
          "minLength": 1,
          "description": "恢复时必须与检查点记录的版本一致；不一致必须拒绝恢复。"
        },
        "stateSchemaVersion": {"type": ["string", "null"], "default": null},
        "mode": {"type": "string", "enum": ["simulation", "dry-run", "real"]},
        "status": {
          "type": "string",
          "enum": ["pending", "running", "waiting-approval", "paused", "completed", "failed",
                   "rejected", "compensated", "cancelled"]
        },
        "logicalTime": {"type": ["number", "null"], "default": null},
        "currentNodeIds": {"type": "array", "default": [], "items": {"type": "string"}},
        "pendingEdgeIds": {"type": "array", "default": [], "items": {"type": "string"}},
        "checkpointId": {"type": ["string", "null"], "default": null},
        "actorId": {"type": ["string", "null"], "default": null},
        "correlationId": {"type": ["string", "null"], "default": null},
        "traceId": {"type": ["string", "null"], "default": null}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpointId", "runId", "workflowVersion", "stateSchemaVersion"],
      "additionalProperties": true,
      "properties": {
        "checkpointId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "workflowVersion": {"type": "string", "minLength": 1},
        "stateSchemaVersion": {
          "type": "string",
          "minLength": 1,
          "description": "检查点记录的状态 schema 版本。缺失即无法校验状态完整性。"
        },
        "stateDigest": {
          "type": ["string", "null"],
          "default": null,
          "description": "状态摘要。用于恢复时校验状态完整性。"
        },
        "createdAt": {"type": ["string", "null"], "default": null},
        "currentNodeIds": {"type": "array", "default": [], "items": {"type": "string"}},
        "pendingEdgeIds": {"type": "array", "default": [], "items": {"type": "string"}}
      }
    }
  }
}
