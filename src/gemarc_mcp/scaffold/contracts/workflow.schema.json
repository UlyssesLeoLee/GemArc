{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemarc.dev/schemas/0.2.0/workflow.schema.json",
  "title": "Canonical Workflow（GWF-IR）",
  "description": "v6.0 提示词 §2.7 与 §17 GWF-IR 6D 扩展。工作流必须具有机器可读语义：节点、端口、关系、条件、异常、输入、输出、执行约束都要可被程序及大模型理解。画布坐标不承载执行语义。所有新增字段都是可选的：旧模型继续有效。6D 字段描述执行契约（执行器、权限、状态、检查点、审批、路由），不构成执行能力：真实执行必须另有获授权的后端。",
  "type": "object",
  "required": ["id", "name", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$"},
    "workflowId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$",
      "description": "§17 workflowId 别名。等同 id；两者同时给出时以 id 为准。"
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"], "default": null},
    "kind": {
      "type": "string",
      "enum": ["task", "decision", "gateway", "start", "end", "subprocess", "event", "data",
               "input", "output", "parallel-fork", "parallel-join", "timer", "wait", "agent",
               "human-approval", "api-call", "data-transform", "subflow", "error-handler",
               "retry", "compensation", "deterministic-program", "agent-loop", "tool-call",
               "policy-gate", "checkpoint", "resume", "manual-review", "escalation", "audit-event"],
      "description": "流程类型，取值见 vocab/workflow-kinds.json nodeKinds"
    },
    "version": {
      "type": ["string", "null"],
      "default": null,
      "description": "GWF-IR 版本。§17 要求 schema_versioning：版本变化必须可审查。"
    },
    "entryPoints": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "入口节点 ID 列表。空数组表示未声明，不得由界面推测。"
    },
    "dataSchemas": {
      "type": "array",
      "default": [],
      "items": {"type": "object"},
      "description": "流程级数据契约目录。必须可被程序读取。"
    },
    "executionPolicy": {
      "type": ["object", "null"],
      "default": null,
      "description": "执行策略：并发度、事务边界、幂等要求等。缺失时按未声明处理。"
    },
    "errorPolicy": {
      "type": ["object", "null"],
      "default": null,
      "description": "全局错误策略：默认重试、默认超时、失败终止方式。缺失时按未声明处理。"
    },
    "permissions": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "执行该流程所需的权限。涉及外部副作用的节点必须在此或节点自身声明权限。"
    },
    "evidenceIds": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "流程级证据引用，指向顶层 evidence 数组。"
    },
    "metadata": {
      "type": "object",
      "default": {},
      "description": "自由元数据。已登记的键必须来自 model-contract 的保留词表。"
    },
    "executionGraph": {
      "type": ["object", "null"],
      "default": null,
      "description": "6D 执行图引用：指向 execution-graph IR 契约（execution-graph.schema.json）。缺失表示该流程没有可执行图。"
    },
    "stateSchemaVersion": {
      "type": ["string", "null"],
      "default": null,
      "description": "6D 共享状态的 schema 版本。所有执行状态必须有版本化 schema；缺失时任何依赖状态的执行都必须被拒绝。"
    },
    "checkpointPolicy": {
      "type": ["object", "null"],
      "default": null,
      "description": "6D 检查点策略：边界、持久化位置与状态完整性要求。缺失时按未声明处理，不得宣称可恢复。"
    },
    "approvalPolicies": {
      "type": "array",
      "default": [],
      "items": {"type": "object"},
      "description": "6D 审批策略目录：审批人角色、超时处理与退回路径。人工审批节点必须引用其中一条。"
    },
    "executionCapabilities": {
      "type": "array",
      "default": [],
      "items": {"type": "string"},
      "description": "6D 声明该流程需要的能力（如 Agent 循环、工具调用、审批）。用于与执行器能力匹配。"
    },
    "runSecurityPolicy": {
      "type": ["object", "null"],
      "default": null,
      "description": "6D 运行安全策略：授权范围、允许的副作用、审计要求。"
    },
    "nodes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$"},
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$",
            "description": "§17 nodeId 别名。等同 id；两者同时给出时以 id 为准。"
          },
          "kind": {
            "type": "string",
            "enum": ["task", "decision", "gateway", "start", "end", "subprocess", "event", "data",
                     "input", "output", "parallel-fork", "parallel-join", "timer", "wait", "agent",
                     "human-approval", "api-call", "data-transform", "subflow", "error-handler",
                     "retry", "compensation", "deterministic-program", "agent-loop", "tool-call",
                     "policy-gate", "checkpoint", "resume", "manual-review", "escalation", "audit-event"],
            "description": "取值见 vocab/workflow-kinds.json nodeKinds"
          },
          "nodeType": {
            "type": "string",
            "description": "§17 nodeType 别名。等同 kind；两者同时给出时以 kind 为准。"
          },
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"], "default": null},
          "canonicalNodeId": {
            "type": ["string", "null"],
            "default": null,
            "description": "绑定的 canonical 节点 ID；纯流程内部元素可为空"
          },
          "implementationRef": {
            "type": ["string", "null"],
            "default": null,
            "description": "实现引用：源码位置或可执行体标识。没有真实执行器时必须为空并标 Design-only。"
          },
          "inputs": {
            "type": "array",
            "default": [],
            "items": {"type": "object"},
            "description": "输入契约。必须可被程序读取。"
          },
          "outputs": {
            "type": "array",
            "default": [],
            "items": {"type": "object"},
            "description": "输出契约。必须可被程序读取。"
          },
          "ports": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "additionalProperties": true,
              "properties": {
                "id": {"type": "string"},
                "portId": {"type": "string", "description": "§17 portId 别名。等同 id。"},
                "kind": {"type": "string", "enum": ["input", "output", "control", "error"]},
                "direction": {
                  "type": ["string", "null"],
                  "default": null,
                  "enum": ["in", "out", "inout", null],
                  "description": "端口方向，取值见 vocab/workflow-kinds.json portDirections"
                },
                "name": {"type": ["string", "null"], "default": null},
                "schemaRef": {"type": ["string", "null"], "default": null},
                "schema": {"type": ["object", "null"], "default": null, "description": "端口数据结构契约。"},
                "cardinality": {
                  "type": ["string", "null"],
                  "default": null,
                  "enum": ["1", "0..1", "0..N", "1..N", "N", null],
                  "description": "基数，取值见 vocab/workflow-kinds.json portCardinalities"
                },
                "required": {"type": "boolean", "default": false},
                "acceptedTypes": {
                  "type": "array",
                  "default": [],
                  "items": {"type": "string"},
                  "description": "可接受的数据类型。端口连线必须通过类型校验。"
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": true,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["order", "exclusive", "parallel", "timeout", "retry", "compensation"]
                },
                "value": {"type": ["number", "string", "boolean", "null"], "default": null},
                "backoffMs": {"type": ["integer", "null"], "minimum": 0, "default": null},
                "onTimeout": {"type": ["string", "null"], "default": null},
                "compensationNodeId": {"type": ["string", "null"], "default": null}
              }
            }
          },
          "dataContract": {
            "type": ["object", "null"],
            "default": null,
            "description": "输入输出的数据契约。必须可被程序读取。"
          },
          "preconditions": {
            "type": "array",
            "default": [],
            "items": {"type": "string"},
            "description": "前置条件。必须可被程序判断。"
          },
          "postconditions": {
            "type": "array",
            "default": [],
            "items": {"type": "string"},
            "description": "后置条件。必须可被程序判断。"
          },
          "stateTransitions": {
            "type": "array",
            "default": [],
            "items": {"type": "object"},
            "description": "状态迁移声明：from / to / trigger。缺失时按未声明处理。"
          },
          "timeoutPolicy": {
            "type": ["object", "null"],
            "default": null,
            "description": "超时策略：时长与超时后的处理。不适用时用有明确定义的 null 或省略。"
          },
          "retryPolicy": {
            "type": ["object", "null"],
            "default": null,
            "description": "重试策略：次数与退避。不适用时用有明确定义的 null 或省略。"
          },
          "errorHandlers": {
            "type": "array",
            "default": [],
            "items": {"type": "object"},
            "description": "错误处理声明。缺失错误处理的危险副作用节点必须被校验拦下。"
          },
          "sideEffects": {
            "type": "array",
            "default": [],
            "items": {"type": "string"},
            "description": "副作用声明。涉及真实 API、Agent、脚本的副作用必须在此登记。"
          },
          "idempotency": {
            "type": ["string", "null"],
            "default": null,
            "description": "幂等要求说明。有副作用的节点必须声明。"
          },
          "verification": {
            "type": ["string", "null"],
            "default": null,
            "enum": ["Implemented", "Observed", "Designed", "Inferred", "Hypothetical", "Unknown", null],
            "description": "该节点的证据等级，取值见 vocab/evidence-levels.json"
          },
          "evidenceIds": {
            "type": "array",
            "default": [],
            "items": {"type": "string"},
            "description": "节点级证据引用，指向顶层 evidence 数组。"
          },
          "exceptionHandling": {
            "type": ["object", "null"],
            "default": null,
            "properties": {
              "onError": {"type": ["string", "null"], "default": null},
              "errorPortId": {"type": ["string", "null"], "default": null}
            },
            "additionalProperties": true
          },
          "canvas": {
            "type": ["object", "null"],
            "default": null,
            "description": "纯表现数据：画布坐标。不得影响执行语义。",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "width": {"type": ["number", "null"], "default": null},
              "height": {"type": ["number", "null"], "default": null}
            },
            "additionalProperties": false
          },
          "executorKind": {
            "type": ["string", "null"],
            "default": null,
            "enum": ["agentic", "deterministic", "human-gated", "external", "routing", "snapshot", "record", "composite", "none", null],
            "description": "6D 执行器类别。§17 要求明确区分 agentic / deterministic / human-gated。"
          },
          "authorityScope": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 权限范围：该节点被允许触达的外部系统或数据域。"
          },
          "executionMode": {
            "type": ["string", "null"],
            "default": null,
            "enum": ["simulation", "dry-run", "real", null],
            "description": "6D 执行模式。默认 simulation；real 必须存在获授权的执行后端，否则拒绝。"
          },
          "inputStateSchema": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 读取状态的 schema 引用。"
          },
          "outputStateSchema": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 写出状态的 schema 引用。"
          },
          "stateWritePolicy": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 状态写入策略：只允许写哪些字段、冲突如何处理。"
          },
          "checkpointBefore": {
            "type": ["boolean", "null"],
            "default": null,
            "description": "6D 是否在该节点执行前提交检查点。"
          },
          "checkpointAfter": {
            "type": ["boolean", "null"],
            "default": null,
            "description": "6D 是否在该节点执行后提交检查点。"
          },
          "budgetPolicy": {
            "type": ["object", "null"],
            "default": null,
            "description": "6D 预算策略：Agent 循环的 token / 时间 / 调用次数上限。"
          },
          "iterationLimit": {
            "type": ["integer", "null"],
            "minimum": 1,
            "default": null,
            "description": "6D Agent 循环的最大迭代次数。缺失即判为无界循环，必须被拒绝。"
          },
          "approvalPolicyRef": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 审批策略引用，指向工作流的 approvalPolicies。"
          },
          "toolContractRef": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 工具契约引用。工具调用节点必须声明，否则不得发起真实调用。"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "sourceId", "targetId", "kind"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$"},
          "edgeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][\\w.:-]{0,127}$",
            "description": "§17 edgeId 别名。等同 id；两者同时给出时以 id 为准。"
          },
          "sourceId": {"type": "string"},
          "targetId": {"type": "string"},
          "sourceNodeId": {
            "type": "string",
            "description": "§17 sourceNodeId 别名。等同 sourceId；两者同时给出时以 sourceId 为准。"
          },
          "targetNodeId": {
            "type": "string",
            "description": "§17 targetNodeId 别名。等同 targetId；两者同时给出时以 targetId 为准。"
          },
          "sourcePortId": {"type": ["string", "null"], "default": null},
          "targetPortId": {"type": ["string", "null"], "default": null},
          "kind": {
            "type": "string",
            "enum": ["control-flow", "data-flow", "event-flow", "error-flow", "conditional-flow",
                     "compensation-flow", "dependency",
                     "state-transition", "approval-transition", "tool-result", "retry-transition",
                     "timeout-transition", "resume-transition",
                     "sequence", "conditional", "message", "association"],
            "description": "取值见 vocab/workflow-kinds.json edgeKinds；旧写法保留兼容读取。"
          },
          "edgeType": {
            "type": "string",
            "description": "§17 edgeType 别名。等同 kind；两者同时给出时以 kind 为准。"
          },
          "directed": {"type": "boolean", "default": true},
          "direction": {
            "type": ["string", "null"],
            "default": null,
            "enum": ["source-to-target", "both", null],
            "description": "§17 direction。source-to-target 等同 directed=true。"
          },
          "condition": {
            "type": ["string", "null"],
            "default": null,
            "description": "kind=conditional-flow 时必填。必须是可被程序判断的表达式。"
          },
          "guard": {
            "type": ["string", "null"],
            "default": null,
            "description": "§17 guard 别名。等同 condition；两者同时给出时以 condition 为准。"
          },
          "dataContract": {"type": ["object", "null"], "default": null},
          "dataMapping": {
            "type": ["object", "null"],
            "default": null,
            "description": "数据映射：从源端口数据到目标端口数据的映射契约。"
          },
          "priority": {
            "type": ["number", "null"],
            "default": null,
            "description": "分支优先级。用于在多个条件分支中确定选择顺序。"
          },
          "errorRoute": {
            "type": ["string", "null"],
            "default": null,
            "description": "出错时改走的边或节点 ID。"
          },
          "verification": {
            "type": ["string", "null"],
            "default": null,
            "enum": ["Implemented", "Observed", "Designed", "Inferred", "Hypothetical", "Unknown", null],
            "description": "该边的证据等级，取值见 vocab/evidence-levels.json"
          },
          "evidenceIds": {
            "type": "array",
            "default": [],
            "items": {"type": "string"},
            "description": "边级证据引用，指向顶层 evidence 数组。"
          },
          "canvas": {
            "type": ["object", "null"],
            "default": null,
            "properties": {"points": {"type": "array", "items": {"type": "object"}}}
          },
          "stateSchemaRef": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 该边传递的状态 schema 引用。传递状态的边必须声明，否则视为未校验状态。"
          },
          "stateProjection": {
            "type": ["object", "null"],
            "default": null,
            "description": "6D 状态投影：源状态如何映射到目标可见的状态字段。"
          },
          "stateMergePolicy": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 状态归并策略。并发分支必须声明，否则无法检测归并冲突。"
          },
          "routingExpression": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 路由表达式：按什么条件选择这条边。条件边必须声明。"
          },
          "deliverySemantics": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 投递语义，例如 at-most-once / at-least-once / exactly-once。"
          },
          "resumeBehavior": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 从检查点恢复时经过这条边的行为。"
          },
          "policyRef": {
            "type": ["string", "null"],
            "default": null,
            "description": "6D 策略引用：决定该边是否允许或需要审批。"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string"},
          "type": {"type": ["string", "null"], "default": null},
          "defaultValue": {"type": ["string", "number", "boolean", "null"], "default": null}
        }
      }
    }
  }
}
