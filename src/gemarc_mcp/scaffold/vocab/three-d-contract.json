{
  "schemaVersion": "0.3.0",
  "id": "three-d-contract",
  "title": "Three.js 多视图架构站：类型与坐标轴映射",
  "description": "MCP 模型与 Three.js 多视图架构站（ipa-architecture-3d 契约）之间的映射表。映射不是猜测：每一条都写明依据；无法无损映射的，保留原始类型供审阅。坐标轴字段是「类别」而非度量，站点据此计算空间信息增量。",
  "nodeKinds": [
    { "mcp": "System", "threeD": "system", "note": "系统边界" },
    { "mcp": "Subsystem", "threeD": "system", "note": "该契约没有子系统这一类，按系统呈现，并在派生结果里保留 mcpKind" },
    { "mcp": "Module", "threeD": "module", "note": "模块" },
    { "mcp": "Component", "threeD": "module", "note": "该契约没有构件这一类，按模块呈现" },
    { "mcp": "Service", "threeD": "service", "note": "服务" },
    { "mcp": "Class", "threeD": "module", "note": "该契约没有类这一类，代码内结构按模块呈现" },
    { "mcp": "Interface", "threeD": "module", "note": "同上" },
    { "mcp": "Method", "threeD": "module", "note": "同上" },
    { "mcp": "Entity", "threeD": "data", "note": "业务实体属数据" },
    { "mcp": "Table", "threeD": "database", "note": "表是数据库对象" },
    { "mcp": "Attribute", "threeD": "data", "note": "属性属数据" },
    { "mcp": "Actor", "threeD": "actor", "note": "参与者" },
    { "mcp": "Event", "threeD": "process", "note": "事件是运行时过程" },
    { "mcp": "State", "threeD": "process", "note": "状态是运行时过程" },
    { "mcp": "Transition", "threeD": "process", "note": "迁移是运行时过程" },
    { "mcp": "Constraint", "threeD": "data", "note": "约束是规则型事实" },
    { "mcp": "Relationship", "threeD": "data", "note": "关系本身是事实" },
    { "mcp": "Evidence", "threeD": "data", "note": "证据是事实" },
    { "mcp": "Scenario", "threeD": "process", "note": "场景是运行时过程" },
    { "mcp": "CausalRule", "threeD": "data", "note": "因果规则是规则型事实" }
  ],
  "edgeKinds": [
    { "mcp": "contains", "threeD": "contains", "note": "包含" },
    { "mcp": "belongsTo", "threeD": "contains", "note": "归属即反向包含" },
    { "mcp": "composes", "threeD": "contains", "note": "组合即包含" },
    { "mcp": "aggregates", "threeD": "contains", "note": "聚合即包含" },
    { "mcp": "dependsOn", "threeD": "depends", "note": "依赖" },
    { "mcp": "calls", "threeD": "calls", "note": "调用" },
    { "mcp": "implements", "threeD": "extends", "note": "实现即扩展" },
    { "mcp": "inherits", "threeD": "extends", "note": "继承即扩展" },
    { "mcp": "transitions", "threeD": "exchanges", "note": "状态迁移是一次事件交换" },
    { "mcp": "triggers", "threeD": "exchanges", "note": "触发是一次事件交换" },
    { "mcp": "reads", "threeD": "reads", "note": "读取" },
    { "mcp": "writes", "threeD": "writes", "note": "写入" },
    { "mcp": "owns", "threeD": "controls", "note": "所有权即控制权" },
    { "mcp": "publishes", "threeD": "publishes", "note": "发布" },
    { "mcp": "subscribes", "threeD": "exchanges", "note": "订阅是一次事件交换" },
    { "mcp": "sends", "threeD": "exchanges", "note": "发送是一次事件交换" },
    { "mcp": "receives", "threeD": "exchanges", "note": "接收是一次事件交换" },
    { "mcp": "constrains", "threeD": "controls", "note": "约束即控制" },
    { "mcp": "evidences", "threeD": "uses", "note": "佐证关系不是该契约的一类，按使用关系呈现" },
    { "mcp": "derivesFrom", "threeD": "depends", "note": "派生即依赖" }
  ],
  "axisFields": [
    "boundary",
    "layer",
    "repo",
    "runtime",
    "environment",
    "dataZone",
    "trustZone",
    "opsLayer",
    "integrationLayer",
    "extensionLayer",
    "failureDomain",
    "domain",
    "owner"
  ],
  "axisSources": [
    { "path": "properties.layer", "axis": "layer", "note": "部署层级" },
    { "path": "properties.runtime", "axis": "runtime", "note": "运行时" },
    { "path": "properties.environment", "axis": "environment", "note": "环境" },
    { "path": "properties.trustZone", "axis": "trustZone", "note": "信任域" },
    { "path": "properties.dataZone", "axis": "dataZone", "note": "数据域" },
    { "path": "properties.boundary", "axis": "boundary", "note": "边界" },
    { "path": "properties.repo", "axis": "repo", "note": "仓库" },
    { "path": "properties.opsLayer", "axis": "opsLayer", "note": "运维层" },
    { "path": "properties.integrationLayer", "axis": "integrationLayer", "note": "集成层" },
    { "path": "properties.extensionLayer", "axis": "extensionLayer", "note": "扩展层" },
    { "path": "properties.failureDomain", "axis": "failureDomain", "note": "故障域" },
    { "path": "properties.owner", "axis": "owner", "note": "责任方" },
    { "path": "domainId", "axis": "domain", "note": "业务域用节点的 domainId，派生时归一到 domain" }
  ],
  "rules": [
    "坐标轴字段是类别，不是度量：不得把风险级别之类的排序伪装成可比较数值。",
    "一根视图的三根轴必须指向三个不同的类别字段，且每个字段在该视图的节点上至少有两个取值，否则这根轴不提供独立信息。",
    "映射表里的每条对应都是显式登记的：没有登记的类型不被悄悄塞进某一类，派生结果会把它列进 unmapped。",
    "派生结果保留节点的原始类型（mcpKind）与边的原始类型（mcpType），映射关系可被逐条复核。"
  ]
}
